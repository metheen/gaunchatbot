[Unit]
Description=Ollama LLM sunucusu (GaunAI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ---- BOOTSTRAP'TA OTOMATİK UYARLANIR (User= satırı) ----
User=gaunai
ExecStart=/usr/local/bin/ollama serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
