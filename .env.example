# GAUN Chatbot — ortam değişkenleri ŞABLONU
# Kullanım:  cp .env.example .env  &&  chmod 600 .env
# Tüm CHANGE_ME değerlerini doldur. Güçlü sır üretimi:
#   openssl rand -base64 24
# .env ASLA git'e commit edilmez (.gitignore'da) ve koda gömülmez.

TZ=Europe/Istanbul

# ----- MariaDB (yapısal veriler / entity tabloları) -----
MARIADB_ROOT_PASSWORD=CHANGE_ME_root_sifresi
MARIADB_DATABASE=gaun_assistant
MARIADB_USER=gaun_app
MARIADB_PASSWORD=CHANGE_ME_uygulama_sifresi
MARIADB_MEM_LIMIT=1g

# ----- Qdrant (vektör veritabanı) -----
QDRANT_API_KEY=CHANGE_ME_uzun_rastgele_anahtar
QDRANT_MEM_LIMIT=2g

# ----- Crawler (Faz 2) -----
# MariaDB host'a port açmaz: crawler gaun_network İÇİNDEN çalışırken 'mariadb',
# (dry-run modu DB'ye hiç bağlanmaz, her yerde çalışır)
MARIADB_HOST=mariadb
MARIADB_PORT=3306
# Rehber form endpoint'i (POST ile çalışır) — canlı sitede doğrulandı.
REHBER_URLS=https://rehber.gaziantep.edu.tr/
# POST arama seed'leri crawler_rehber.py içindeki SEED_LIST sabitinden gelir.
# Kendimizi dürüstçe tanıtan User-Agent (görgü kuralı)
CRAWLER_USER_AGENT=GaunChatbotCrawler/0.1 (BIDB)

# ----- RAG botu (bot.py, Faz 2) -----
# Qdrant erişim adresi. Bot host'tan (venv) çalışıyorsa 127.0.0.1;
# ağ içinden (konteyner) çalışıyorsa http://qdrant:6333
QDRANT_URL=http://127.0.0.1:6333
# Personel koleksiyonu (yapısal/semantik). Yönetmelikler ayrı 'regulations'
# koleksiyonunda (bkz. setup_regulations_db.py); bot.py ikisine de bakar.
QDRANT_COLLECTION=staff
REGULATIONS_COLLECTION=regulations
# Ollama host makinede çalışır (Docker'da değil) — host'tan erişim.
# NOT: ollama kütüphanesi normalde yalnız OLLAMA_HOST okur; bot.py bu URL'yi
# load_dotenv sonrası ollama istemcisine aktarır (_configure_ollama_host), böylece
# Ollama farklı bir hosttaysa buradan yönlendirebilirsin.
OLLAMA_URL=http://127.0.0.1:11434
# Embedding: bge-m3 (1024, çok dilli, TR güçlü) — `ollama pull bge-m3`.
OLLAMA_EMBED_MODEL=bge-m3
# Faz 4: Türkçe üretim için daha güçlü qwen2.5:7b-instruct modeli.
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
RAG_TOP_K=5
# Alaka eşiği: bu skorun altındaki retrieval isabetleri elenir (grounding
# sertleştirme; retrieve_semantic'te etkin). 0 = kapalı (en yakın K'yı getir).
# bge-m3 cosine skorları için makul başlangıç ~0.4-0.5 (deneyerek ayarla).
RAG_SCORE_THRESHOLD=0

# ----- Canlı veri (Faz 9) — anlık çekilen konular -----
# Bu kaynaklar Qdrant/cache'e girmez; her soruda siteden taze çekilir.
LIVE_YEMEK_URL=https://www.gaziantep.edu.tr/yemek/
LIVE_DUYURU_URL=https://www.gaziantep.edu.tr/

# ----- API (Faz 7) — üçüncü taraf sayfaya (gaziantep.edu.tr) gömülü widget -----
# Virgülle ayrık, gerçek origin(ler). BOŞ = "*" (yalnız yerel geliştirme).
# Production'da MUTLAKA ayarlanmalı, aksi halde CORS herkese açık kalır.
# ALLOWED_ORIGINS=https://www.gaziantep.edu.tr,https://gaziantep.edu.tr

# ----- Canlı web araması (Faz 17) — genel/güncel sorular için -----
# ÜCRETSİZ + KURUMSAL için ÖNERİLEN: kendi SearXNG örneğin (anahtarsız/sınırsız,
# rate-limit YOK). Docker: `docker run -d -p 8888:8080 searxng/searxng`
# SEARXNG_URL=http://127.0.0.1:8888
# Opsiyonel anahtarlı sağlayıcı (kurmazsan DuckDuckGo→Wikipedia zincirine düşer):
# BRAVE_SEARCH_API_KEY=
# WIKI_API_URL=https://tr.wikipedia.org/w/api.php   # ücretsiz son-çare (varsayılan)

# ----- GAÜN Kapsam Kilidi (Faz 20) -----
# true (varsayılan): bot YALNIZ üniversiteyle ilgili sorulara cevap verir;
# üniversite-dışı sorular kibarca reddedilir ve web aramaları GAÜN'e sabitlenir.
# false: genel-asistan modu (genel sorular da web'den yanıtlanır).
GAUN_ONLY_MODE=true

# ----- BİDB Admin/Telemetri (Faz 19) -----
# /api/admin/stats yetki anahtarı. BOŞSA endpoint TAMAMEN kapalı (401).
# Üret: python -c "import secrets;print('gaunai_admin_'+secrets.token_urlsafe(24))"
ADMIN_API_KEY=

# ----- Kurumsal serving (Faz 17) — güvenlik/dayanıklılık -----
RATE_LIMIT_PER_MIN=20          # IP başına /api/chat dakikalık istek sınırı (DoS)
FEEDBACK_LIMIT_PER_MIN=30      # IP başına /api/feedback sınırı
REQUEST_TIMEOUT_SEC=60         # asılı LLM/ağ çağrısı için istek zaman aşımı
API_MAX_WORKERS=4              # eşzamanlı iş havuzu (8GB'de düşük tut)
MAX_QUESTION_CHARS=2000        # aşırı uzun girdiyi reddet (DoS)
MAX_HISTORY_ITEMS=20           # geçmiş penceresi üst sınırı
