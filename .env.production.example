# GAUN Chatbot — PRODUCTION .env örneği (BİDB devir-teslim)
# Bu dosyayı `.env` olarak kopyalayıp GERÇEK değerlerle doldurun. ASLA commit
# etmeyin (.env gitignore'da). Tüm sırlar güçlü ve rastgele olmalı.

TZ=Europe/Istanbul

# ----- Veritabanı / Vektör (yerel Docker) -----
MARIADB_ROOT_PASSWORD=DEĞİŞTİR-güçlü-rastgele
MARIADB_DATABASE=gaun_assistant
MARIADB_USER=gaun_app
MARIADB_PASSWORD=DEĞİŞTİR-güçlü-rastgele
MARIADB_HOST=127.0.0.1
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=DEĞİŞTİR-güçlü-rastgele
QDRANT_COLLECTION=staff

# ----- LLM / Embedding (yerel Ollama) -----
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0

# ----- BİDB Admin/Telemetri (ZORUNLU) -----
# /api/admin/stats endpoint yetki anahtarı. BOŞSA endpoint 401 verir (kapalı).
# Üret: python -c "import secrets;print('gaunai_admin_'+secrets.token_urlsafe(24))"
ADMIN_API_KEY=DEĞİŞTİR-güçlü-rastgele

# ----- Canlı web araması (opsiyonel — ücretsiz zincir varsayılan) -----
# SEARXNG_URL=http://127.0.0.1:8888
# BRAVE_SEARCH_API_KEY=

# ----- Kurumsal serving (güvenlik/dayanıklılık) -----
# CORS: production'da MUTLAKA gerçek origin(ler)e daraltın (aksi halde herkese açık).
ALLOWED_ORIGINS=https://www.gaziantep.edu.tr,https://gaziantep.edu.tr
RATE_LIMIT_PER_MIN=20
FEEDBACK_LIMIT_PER_MIN=30
REQUEST_TIMEOUT_SEC=60
API_MAX_WORKERS=4
MAX_QUESTION_CHARS=2000
MAX_HISTORY_ITEMS=20

# ----- Öğrenme (data-poisoning eşikleri) -----
LEARN_APPROVAL_THRESHOLD=3     # aktif olmak için gereken FARKLI-IP 👍
LEARN_REMOVE_SCORE=-2          # bu skora düşen öğrenme gizlenir
